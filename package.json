{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/tech-ai dev",
    "dev:api": "pnpm --filter @workspace/api-server dev",
    "dev:client": "pnpm --filter @workspace/tech-ai dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "start": "pnpm --filter @workspace/api-server start",
    "preview": "pnpm --filter @workspace/tech-ai serve"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "argon2",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.28.2",
    "@rollup/rollup-win32-x64-msvc": "4.63.1",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
