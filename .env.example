# Tech AI - Environment Variables Reference

# LiveKit WebRTC Real-Time Voice Rooms
# Get free credentials at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# PostgreSQL Database (Optional - falls back gracefully to in-memory mode if omitted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tech_ai

# Google Gemini API Key (For AI Teacher & Smart Explanations)
GEMINI_API_KEY=your_gemini_api_key

# Node Environment & Port
NODE_ENV=development
PORT=3000
